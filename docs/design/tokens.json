{
  "$schema": "https://designtokens.org/draft-01/",
  "color": {
    "canvas":         { "$value": "#090909", "$type": "color", "$description": "Application canvas background" },
    "surface":        { "$value": "#101010", "$type": "color", "$description": "Sidebar and panel background" },
    "surface": {
      "hover":        { "$value": "#1B1B1B", "$type": "color", "$description": "Hover surface" },
      "active":       { "$value": "#262626", "$type": "color", "$description": "Active / selected surface" },
      "raised":       { "$value": "#1B1B1B", "$type": "color", "$description": "Raised surface (cards, dialogs)" }
    },
    "border":         { "$value": "#303030", "$type": "color", "$description": "Default border" },
    "border": {
      "strong":       { "$value": "#454545", "$type": "color", "$description": "Strong border (emphasis)" }
    },
    "text": {
      "primary":      { "$value": "#F2F2F2", "$type": "color", "$description": "Primary text" },
      "secondary":    { "$value": "#A0A0A0", "$type": "color", "$description": "Secondary text" },
      "muted":        { "$value": "#858585", "$type": "color", "$description": "Muted icons and hints" },
      "inverse":      { "$value": "#090909", "$type": "color", "$description": "Inverse text (on light bg)" }
    },
    "icon": {
      "default":      { "$value": "#858585", "$type": "color", "$description": "Default icon" },
      "active":       { "$value": "#F2F2F2", "$type": "color", "$description": "Active icon" }
    },
    "focus": {
      "ring":         { "$value": "#F2F2F2", "$type": "color", "$description": "Focus ring color (monochrome)" },
      "surface":      { "$value": "#262626", "$type": "color", "$description": "Focus background surface" }
    },
    "scrim":          { "$value": "rgba(0,0,0,0.62)", "$type": "color", "$description": "Modal backdrop" }
  },
  "spacing": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "24px", "$type": "dimension" },
    "6":  { "$value": "32px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "3px", "$type": "dimension" },
    "md": { "$value": "6px", "$type": "dimension" },
    "lg": { "$value": "8px", "$type": "dimension" }
  },
  "borderWidth": {
    "hairline": { "$value": "1px", "$type": "dimension" },
    "focus":    { "$value": "2px", "$type": "dimension" }
  },
  "fontSize": {
    "metadata":    { "$value": "10px", "$type": "dimension" },
    "supporting":  { "$value": "11px", "$type": "dimension" },
    "label":       { "$value": "12px", "$type": "dimension" },
    "body":        { "$value": "13px", "$type": "dimension" },
    "component":   { "$value": "14px", "$type": "dimension" },
    "section":     { "$value": "16px", "$type": "dimension" },
    "title":       { "$value": "20px", "$type": "dimension" }
  },
  "fontWeight": {
    "regular":   { "$value": "400", "$type": "fontWeights" },
    "medium":    { "$value": "500", "$type": "fontWeights" },
    "semibold":  { "$value": "600", "$type": "fontWeights" }
  },
  "dimension": {
    "height": {
      "control-sm": { "$value": "28px", "$type": "dimension" },
      "control-md": { "$value": "36px", "$type": "dimension" },
      "control-lg": { "$value": "44px", "$type": "dimension" },
      "row":        { "$value": "36px", "$type": "dimension" }
    },
    "width": {
      "sidebar-expanded": { "$value": "260px", "$type": "dimension" },
      "sidebar-collapsed": { "$value": "64px", "$type": "dimension" }
    },
    "icon": {
      "sm": { "$value": "14px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" }
    }
  },
  "fontFamily": {
    "ui": { "$value": "Inter, sans-serif", "$type": "fontFamilies" },
    "mono": { "$value": "JetBrains Mono, monospace", "$type": "fontFamilies" }
  }
}
