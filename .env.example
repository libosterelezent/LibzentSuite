# SlaughterMudae — example credentials file.
# Copy to .env and fill in. IDs and dashboard auth live here; ACCOUNT TOKENS are stored encrypted in
# the database (see README 'Credentials & IDs').

# Mudae bot user id (public identifier)
MUDAE_BOT_ID=432610292342587392

# Comma-separated Discord user IDs allowed to issue plugin commands AND
# mention-prefix management commands (e.g. 123456789012345678)
OWNER_USER_IDS=

# Account credentials are stored ENCRYPTED in the database via the
# dashboard or CLI — NOT in this file. To import existing .env tokens
# one time, use the dashboard's "import .env credentials" button or:
#   python3 main.py credentials import-env
# DISCORD_TOKEN_* entries are read ONLY by that explicit migration command.

# Optional: local dashboard auth token
DASHBOARD_TOKEN=

# Optional: mention-prefix management from Discord (@account status ...).
# Owner-only either way; set 0 to disable the wiring entirely.
REMOTE_CONTROL=1

# Master key for the encrypted credential store — PROCESS ENVIRONMENT ONLY
# (this .env parser does NOT feed it): export SM_MASTER_KEY=<urlsafe base64
# Fernet key>, or let the framework generate state/credentials.key (0600,
# back it up — losing it forces re-entering every stored token).
