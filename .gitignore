# --- secrets & credentials (NEVER commit) ---
.env
.env.*
!.env.example
accounts/
*.token
*_token.txt
credentials.key*


# --- local runtime state ---
config/accounts/*.local.json
*.log
state/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
docs/_build/
# the knowledgebase is committed; only its generated machine data is local
knowledgebase/
knowledgebase_*.db

# python build artifacts (uv build / pip install -e .)
/dist/
/build/
*.egg-info/
