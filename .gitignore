# --- secrets & credentials (NEVER commit) ---
.env
.env.*
!.env.example
accounts/
*.token
*_token.txt
credentials.key*


# --- local runtime state ---
config/accounts/*.local.json
*.log
state/
.vscode/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
docs/_build/
# the knowledgebase is stored locally to avoid irrelevant repo size expansion.
knowledgebase/

# --- local-only agent tooling (skills, session config) ---
# personal per-machine configuration: the agent skills and the opencode
# session config never leave the machine that uses them
.agents/
opencode.json
opencode.jsonc
.opencode/


# --- local-only archives ---
# the retirement wing and the knowledgebase live on the machine that
# built them; a fresh clone gets the repo, the docs, and dump/'s README
# pointer in the roadmap — not the archives themselves
dump/*
!dump/README.md
knowledgebase/

# live-debugging toolkit output (findings JSONL + run summaries are run artifacts)
scripts/live-debugging/findings/
# python build artifacts (uv build / pip install -e .)
/dist/
/build/
*.egg-info/
