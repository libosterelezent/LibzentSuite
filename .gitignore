__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
docs/_build/
# the knowledgebase is committed; only its generated machine data is local
knowledgebase/generated/
knowledgebase_*.db
