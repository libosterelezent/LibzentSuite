# --- secrets & credentials (NEVER commit) ---
.env
.env.*
!.env.example
accounts/
*.token
*_token.txt
credentials.key*


# --- local runtime state ---
config/accounts/*.local.json
*.log
state/
.vscode/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
docs/_build/
# the knowledgebase is stored locally to avoid irrelevant repo size expansion.
knowledgebase/

# --- local-only agent tooling (skills, session config) ---
# personal per-machine configuration: the agent skills and the opencode
# session config never leave the machine that uses them
.agents/
opencode.json
opencode.jsonc
.opencode/

# python build artifacts (uv build / pip install -e .)
/dist/
/build/
*.egg-info/
